# Copy to .env and fill in. Never commit .env.

# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=

# Long random string; TradingView must send it (see README). e.g. `openssl rand -hex 24`
WEBHOOK_SECRET=

CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
MIN_CONFIDENCE=60
SEND_SUPPRESSED=false
DEDUP_WINDOW_SECONDS=60
HISTORY_SIZE=10
# Your strategy and rules, in plain words. Claude uses this when judging alerts.
TRADER_CONTEXT=I swing trade BTC and ETH on 1h/4h. I only care about signals that agree with the 4h trend.

# Notification channels: fill in any you want.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
NTFY_TOPIC_URL=
